ENV=local
PORT=8082
HTTP_BIND_ADDRESS=0.0.0.0

# Write-capable role. The schema itself is owned and migrated by Core-Service.
DATABASE_URL=postgres://ingestion:password@localhost:5432/event

# --- Ingestion: pulling posts from Instagram ---

# Long-lived token (60 days). Refresh it BEFORE it expires — once it lapses the
# full OAuth flow has to be redone.
IG_ACCESS_TOKEN=EAAG...
# Our own IG Business account: the node Business Discovery queries run against.
IG_USER_ID=17841400000000000
# Pin the version. Never rely on the Graph API default.
IG_API_VERSION=v25.0
IG_MEDIA_LIMIT=25

CRON_SCHEDULE=0 */6 * * *
WORKER_CONCURRENCY=3
RUN_ON_STARTUP=false

# Optional. Empty disables alerting (fatal errors are still logged).
GOOGLE_CHAT_WEBHOOK_URL=

# --- Processing: extracting events from raw posts ---

ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5
# Caps each extraction so a runaway response cannot inflate the bill.
LLM_MAX_TOKENS=500
# How many pending posts one run submits. Guards against a first-day backlog
# larger than a single batch; the API caps a batch at 100,000 requests.
LLM_POST_LIMIT=5000

BATCH_POLL_INTERVAL=30s
# Past this the run is marked failed and its posts stay pending for the next
# run. The batch keeps running on Anthropic's side and its results stay
# fetchable for 29 days, so nothing is lost — it just costs a second batch.
BATCH_POLL_TIMEOUT=2h

# Self-host this if the public instance's rate limit becomes a bottleneck.
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
# Mandatory: Nominatim blocks clients it cannot identify. Put a real contact in it.
GEOCODE_USER_AGENT=naidee-service/1.0 (contact@example.com)
# The public instance allows one request per second and blocks IPs that go
# faster. Do not lower this unless you are pointing at your own instance.
GEOCODE_MIN_INTERVAL=1s

# Runs on its own, faster-ticking schedule from CRON_SCHEDULE above — different
# job, different timing.
PROCESSING_CRON_SCHEDULE=*/30 * * * *
PROCESSING_RUN_ON_STARTUP=false

# --- Admin API ---
# One key guards all three admin routes (POST /api/v1/admin/ingestion/trigger,
# POST /api/v1/admin/processing/runs, GET /api/v1/admin/processing/runs/{id}).
# Leave it empty and none of them are registered at all — cron-only deployments
# are fine without it. Minimum 32 characters, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=
