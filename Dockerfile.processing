# Stage 1: Build
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Cache the module download layer separately from the source.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Static binary so the runtime stage needs no libc.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /app/processing ./cmd/processing

# Stage 2: Production
FROM alpine:3.20

WORKDIR /app

# Certificates for the outbound HTTPS calls to api.anthropic.com and the geocoder.
# The tzdata database is embedded in the binary, so no tzdata package is needed.
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 processing

COPY --from=builder /app/processing /app/processing

USER processing

# The merged config.go defaults PORT to 8082 (cmd/ingestion's original
# default) and HTTP_BIND_ADDRESS to 0.0.0.0 (also cmd/ingestion's original,
# always-public default) — cmd/processing's admin routes must not inherit
# that, so both are pinned explicitly here rather than left to the default.
ENV PORT=8083
ENV HTTP_BIND_ADDRESS=127.0.0.1

EXPOSE 8083

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8083/healthz || exit 1

CMD ["/app/processing"]
